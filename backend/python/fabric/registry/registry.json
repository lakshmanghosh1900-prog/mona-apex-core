{
  "canonical_spec": "MONA — Powered by Apex Core",
  "version": "1.1",
  "stage": "Phase 1 / Stage 1.1 — Tool Registry",
  "spec_ref": "MONA_POWERED_BY_APEX_FINAL_BLUEPRINT.md",
  "dod_ref": "Understand → Plan → Select Model → Select Tool → Check Permission → Approval → Execute in Sandbox → Observe → Verify → Self-Heal → Evidence → Memory → Report → Resume Later",
  "tools": [
    {
      "tool_name": "browser.search",
      "description": "Search the web through a zero-cost search endpoint and return ranked result snippets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 500},
          "max_results": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5}
        },
        "required": ["query"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "url": {"type": "string"},
                "snippet": {"type": "string"}
              }
            }
          },
          "provider": {"type": "string"}
        },
        "required": ["results"]
      },
      "permission_level": "READ",
      "risk_level": "LOW",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 30,
      "retry_policy": {"max_attempts": 3, "backoff_seconds": 1.0, "backoff_multiplier": 2.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 30, "redact_fields": []}
    },
    {
      "tool_name": "browser.open",
      "description": "Open a URL in the sandboxed browser and return cleaned page text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "pattern": "^https?://"},
          "max_chars": {"type": "integer", "minimum": 100, "maximum": 50000, "default": 8000}
        },
        "required": ["url"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "url": {"type": "string"},
          "title": {"type": "string"},
          "text": {"type": "string"},
          "status_code": {"type": "integer"}
        },
        "required": ["url", "text"]
      },
      "permission_level": "READ",
      "risk_level": "LOW",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 45,
      "retry_policy": {"max_attempts": 2, "backoff_seconds": 1.0, "backoff_multiplier": 2.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 30, "redact_fields": []}
    },
    {
      "tool_name": "files.read",
      "description": "Read a text file from the workspace and return its contents.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "max_chars": {"type": "integer", "minimum": 100, "maximum": 200000, "default": 50000}
        },
        "required": ["path"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"},
          "bytes": {"type": "integer"}
        },
        "required": ["path", "content"]
      },
      "permission_level": "READ",
      "risk_level": "LOW",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 15,
      "retry_policy": {"max_attempts": 2, "backoff_seconds": 0.5, "backoff_multiplier": 2.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 30, "redact_fields": []}
    },
    {
      "tool_name": "files.write",
      "description": "Write or overwrite a file inside the workspace. Mutating action.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "required": ["path", "content"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "bytes_written": {"type": "integer"}
        },
        "required": ["path", "bytes_written"]
      },
      "permission_level": "WRITE",
      "risk_level": "HIGH",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 15,
      "retry_policy": {"max_attempts": 1, "backoff_seconds": 0.0, "backoff_multiplier": 1.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 90, "redact_fields": []}
    },
    {
      "tool_name": "code.run",
      "description": "Execute a Python snippet inside the isolated sandbox and return stdout/stderr.",
      "input_schema": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 20000},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60, "default": 15}
        },
        "required": ["code"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "stdout": {"type": "string"},
          "stderr": {"type": "string"},
          "exit_code": {"type": "integer"}
        },
        "required": ["exit_code"]
      },
      "permission_level": "EXECUTE",
      "risk_level": "HIGH",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 60,
      "retry_policy": {"max_attempts": 1, "backoff_seconds": 0.0, "backoff_multiplier": 1.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 90, "redact_fields": []}
    },
    {
      "tool_name": "sheets.write",
      "description": "Append or update rows in a spreadsheet. Mutating action.",
      "input_schema": {
        "type": "object",
        "properties": {
          "sheet_id": {"type": "string", "minLength": 1},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
          "mode": {"type": "string", "enum": ["append", "replace"]}
        },
        "required": ["sheet_id", "rows"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "sheet_id": {"type": "string"},
          "rows_written": {"type": "integer"}
        },
        "required": ["sheet_id", "rows_written"]
      },
      "permission_level": "WRITE",
      "risk_level": "HIGH",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 30,
      "retry_policy": {"max_attempts": 2, "backoff_seconds": 1.0, "backoff_multiplier": 2.0},
      "authentication": {"required": true, "type": "api_key", "env_var": "GOOGLE_SHEETS_ID"},
      "audit_policy": {"log": true, "retain_days": 90, "redact_fields": ["rows"]}
    },
    {
      "tool_name": "email.send",
      "description": "Send an email through the configured SMTP relay. Externally visible action.",
      "input_schema": {
        "type": "object",
        "properties": {
          "to": {"type": "string", "pattern": "^[^@]+@[^@]+\\.[^@]+$"},
          "subject": {"type": "string", "minLength": 1, "maxLength": 300},
          "body": {"type": "string", "minLength": 1, "maxLength": 50000}
        },
        "required": ["to", "subject", "body"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "message_id": {"type": "string"},
          "accepted": {"type": "boolean"}
        },
        "required": ["accepted"]
      },
      "permission_level": "SEND",
      "risk_level": "HIGH",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 30,
      "retry_policy": {"max_attempts": 2, "backoff_seconds": 2.0, "backoff_multiplier": 2.0},
      "authentication": {"required": true, "type": "smtp", "env_var": "SMTP_URL"},
      "audit_policy": {"log": true, "retain_days": 365, "redact_fields": ["body"]}
    },
    {
      "tool_name": "research.search",
      "description": "Run a multi-source research query and return cited evidence snippets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "topic": {"type": "string", "minLength": 1, "maxLength": 500},
          "max_sources": {"type": "integer", "minimum": 1, "maximum": 15, "default": 5}
        },
        "required": ["topic"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "topic": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {"type": "string"},
                "source_url": {"type": "string"},
                "confidence": {"type": "number"}
              }
            }
          }
        },
        "required": ["topic", "evidence"]
      },
      "permission_level": "READ",
      "risk_level": "LOW",
      "cost": {"currency": "USD", "per_call": 0.0, "budget_per_task": 0.0},
      "timeout": 60,
      "retry_policy": {"max_attempts": 3, "backoff_seconds": 1.5, "backoff_multiplier": 2.0},
      "authentication": {"required": false, "type": null, "env_var": null},
      "audit_policy": {"log": true, "retain_days": 90, "redact_fields": []}
    }
  ]
}
