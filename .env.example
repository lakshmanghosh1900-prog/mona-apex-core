# ============================================================================
#  Mona (Powered by Apex Core) - environment file
#  Setup:  cp .env.example .env   then edit .env
#
#  REQUIRED  -> only the model key block (at least ONE of GEMINI / GROQ)
#  OPTIONAL  -> everything else has a working default (local Ollama, echo)
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED - AI model keys (zero-cost free tier, pick at least one)
# ----------------------------------------------------------------------------

# Google AI Studio - free tier, https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq - free tier, https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Exact model ids used by each provider (change only if you want another model)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile


# ----------------------------------------------------------------------------
# OPTIONAL - HTTP server
# ----------------------------------------------------------------------------

# Port the FastAPI backend listens on (Docker already maps 8000:8000)
PORT=8000

# development | production
NODE_ENV=development

# Browser origins allowed to call the API (comma separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# ----------------------------------------------------------------------------
# OPTIONAL - local model fallback (Ollama), used when no API key is set
# ----------------------------------------------------------------------------

# URL of a local Ollama daemon
OLLAMA_URL=http://localhost:11434

# Preferred model. If it is missing, Mona auto-picks the first installed model
OLLAMA_MODEL=llama3.2

# Seconds before a local model call is aborted (cold model load can be slow)
OLLAMA_TIMEOUT=120


# ----------------------------------------------------------------------------
# OPTIONAL - self-healing orchestrator
# ----------------------------------------------------------------------------

# 1 = run through LangGraph, 0 = builtin sequential fallback engine
USE_LANGGRAPH=1

# How many times a failed plan/act/verify cycle is repaired before giving up
MAX_HEAL_ATTEMPTS=3

# Retries per provider before moving to the next provider in the chain
LLM_MAX_RETRIES=3

# Seconds before a cloud LLM call is aborted
LLM_TIMEOUT=45


# ----------------------------------------------------------------------------
# OPTIONAL - long-term memory (Mem0 + Qdrant)
# ----------------------------------------------------------------------------

# Qdrant HTTP endpoint (compose rewrites this to http://qdrant:6333)
QDRANT_URL=http://localhost:6333

# Qdrant collection name
QDRANT_COLLECTION=mona_memory

# Empty for a local/unsecured Qdrant, otherwise your cloud Qdrant key
QDRANT_API_KEY=

# Mem0 cloud hybrid memory, leave empty to stay 100% local
MEM0_API_KEY=

# How many memories are returned per recall
MEMORY_TOP_K=6

# Cosine similarity floor (0.0 - 1.0) below which a memory is dropped
MEMORY_SCORE_THRESHOLD=0.35


# ----------------------------------------------------------------------------
# OPTIONAL - Telegram human-in-the-loop approval gate
# Leave empty and Mona waits for human approval (TELEGRAM_AUTO_APPROVE=0) - production default
# Set TELEGRAM_AUTO_APPROVE=1 ONLY in isolated dev environments
# ----------------------------------------------------------------------------

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal chat id, get it from @userinfobot
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# Seconds to wait for an approve/deny tap before the action is cancelled
TELEGRAM_APPROVAL_TIMEOUT=300

# 0 = deny (wait for human approval) when Telegram is not configured, 1 = auto-approve (dev only)
TELEGRAM_AUTO_APPROVE=0


# ----------------------------------------------------------------------------
# OPTIONAL - stealth / scraping proxy
# ----------------------------------------------------------------------------

PROXY_RESIDENTIAL_USER=
PROXY_RESIDENTIAL_PASS=
PROXY_ENDPOINT=gate.dataimpulse.com:823


# ----------------------------------------------------------------------------
# OPTIONAL - third party integrations (unused until filled)
# ----------------------------------------------------------------------------

GOOGLE_SHEETS_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=


# ----------------------------------------------------------------------------
# OPTIONAL - durable sandbox state root (gates P1+P4)
# All registry subsystems (memory, audit, execution, tenants, rate limits)
# store state under this single directory. Empty = ~/.mona/sandbox
# ----------------------------------------------------------------------------
MONA_STATE_DIR=
