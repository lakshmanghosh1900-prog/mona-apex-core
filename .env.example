# ====================== MONA (Powered by Apex Core) ======================

# Server
PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Models (Free tiers)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Local fallback model (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Self-healing orchestrator
MAX_HEAL_ATTEMPTS=3
LLM_MAX_RETRIES=3
LLM_TIMEOUT=45
USE_LANGGRAPH=1

# Long-term Memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mona_memory
QDRANT_API_KEY=
MEM0_API_KEY=
MEMORY_TOP_K=6
MEMORY_SCORE_THRESHOLD=0.35

# Telegram Human-in-the-Loop
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_APPROVAL_TIMEOUT=300
TELEGRAM_AUTO_APPROVE=1

# Optional Stealth / Scraping
PROXY_RESIDENTIAL_USER=
PROXY_RESIDENTIAL_PASS=
PROXY_ENDPOINT=gate.dataimpulse.com:823

# Optional Integrations
GOOGLE_SHEETS_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
