# Mona web (Next.js PWA) - copy to apps/web/.env.local for local overrides

# OPTIONAL - absolute backend URL used by the browser.
# Leave EMPTY to go through the built-in /api proxy (recommended for local dev
# and for Vercel, where next.config.js forwards /api/* to API_URL).
# Set it only when the API is on another origin, e.g. https://api.mona.example.
NEXT_PUBLIC_API_URL=

# OPTIONAL - target of the server-side /api proxy rewrite.
# Defaults to http://localhost:8000 when empty.
API_URL=http://localhost:8000
